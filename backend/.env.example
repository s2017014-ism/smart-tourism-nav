# 複製為 .env 後修改。所有變數皆以 STN_ 為前綴。

# 一般成人步行速度（公尺/秒）
STN_WALKING_SPEED_MPS=1.35

# 路網型態：walk / bike / drive / all
STN_NETWORK_TYPE=walk

# 澳門 bounding box (left=西, bottom=南, right=東, top=北, EPSG:4326)
STN_BBOX_W=113.528
STN_BBOX_S=22.105
STN_BBOX_E=113.600
STN_BBOX_N=22.225

# ---- Phase 5：LLM 意圖解析（任何 OpenAI 相容 API）----
# 預設使用 DeepSeek：只要在下面「STN_LLM_API_KEY=」後面填入你的金鑰即可啟用。
# （三行都要存在、且行首不能有 #）
STN_LLM_BASE_URL=https://api.deepseek.com/v1
STN_LLM_MODEL=deepseek-chat
STN_LLM_API_KEY=
# 未填金鑰時，系統會改用「規則式」解析（仍可使用）。
#
# 想改用其他供應商，直接替換上面兩行的值即可，例如：
#   OpenAI         : STN_LLM_BASE_URL=https://api.openai.com/v1
#                    STN_LLM_MODEL=gpt-4o-mini
#   Qwen(DashScope): STN_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#                    STN_LLM_MODEL=qwen-plus
#   OpenRouter     : STN_LLM_BASE_URL=https://openrouter.ai/api/v1
#                    STN_LLM_MODEL=qwen/qwen-2.5-72b-instruct
#   本地 Ollama    : STN_LLM_BASE_URL=http://localhost:11434/v1
#                    STN_LLM_MODEL=qwen2.5:7b

# ---- Phase 6：天氣（Open-Meteo，免金鑰）----
# 可選：調整天氣查詢座標（預設為澳門中心）
# STN_WEATHER_LAT=22.1987
# STN_WEATHER_LON=113.5439
