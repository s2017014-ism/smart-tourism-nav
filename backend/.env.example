# 複製為 .env 後修改。所有變數皆以 STN_ 為前綴。

# 一般成人步行速度（公尺/秒）
STN_WALKING_SPEED_MPS=1.35

# 路網型態：walk / bike / drive / all
STN_NETWORK_TYPE=walk

# 澳門 bounding box (left=西, bottom=南, right=東, top=北, EPSG:4326)
STN_BBOX_W=113.528
STN_BBOX_S=22.105
STN_BBOX_E=113.600
STN_BBOX_N=22.225

# ---- Phase 5：LLM 意圖解析（任何 OpenAI 相容 API，非限定 OpenAI）----
# 只要供應商提供 /chat/completions 端點即可；不支援 tools 時會自動退回純 JSON。
#
# 範例（擇一填寫）：
#  阿里雲 DashScope（Qwen）:
#    STN_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#    STN_LLM_MODEL=qwen-plus
#  DeepSeek:
#    STN_LLM_BASE_URL=https://api.deepseek.com/v1
#    STN_LLM_MODEL=deepseek-chat
#  OpenRouter（可轉接多家模型）:
#    STN_LLM_BASE_URL=https://openrouter.ai/api/v1
#    STN_LLM_MODEL=qwen/qwen-2.5-72b-instruct
#  本地 Ollama:
#    STN_LLM_BASE_URL=http://localhost:11434/v1
#    STN_LLM_MODEL=qwen2.5:7b
#  本地 vLLM / LM Studio:
#    STN_LLM_BASE_URL=http://localhost:8001/v1
#    STN_LLM_MODEL=你的模型
#
# STN_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# STN_LLM_API_KEY=sk-xxx
# STN_LLM_MODEL=qwen-plus

# ---- Phase 6：動態資料 ----
# STN_WEATHER_API_KEY=xxx
